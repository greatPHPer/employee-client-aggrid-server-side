        [HttpGet("chat/messages/{user1}/{user2}")]
        public IActionResult GetChatMessages(string user1, string user2)
        {
            // Update your SQL selection statement to include IsRead
            string sql = @"SELECT Id, SenderId, ReceiverId, MessageContent, Timestamp, IsRead 
                   FROM Gen_Tra_ChatMessages 
                   WHERE (SenderId = @u1 AND ReceiverId = @u2) 
                      OR (SenderId = @u2 AND ReceiverId = @u1)
                   ORDER BY Timestamp ASC";

            DataTable dt = DataHelper.GetTable(sql,
                new Parameter("@u1", SqlDbType.VarChar, user1),
                new Parameter("@u2", SqlDbType.VarChar, user2));

            List<ChatMessageDto> list = new List<ChatMessageDto>();
            foreach (DataRow row in dt.Rows)
            {
                list.Add(new ChatMessageDto
                {
                    Id = Convert.ToInt32(row["Id"]),
                    SenderId = row["SenderId"].ToString()!,
                    ReceiverId = row["ReceiverId"].ToString()!,
                    MessageContent = row["MessageContent"].ToString()!,
                    Timestamp = Convert.ToDateTime(row["Timestamp"]),
                    IsRead = Convert.ToBoolean(row["IsRead"]) // <-- MAP FIELD HERE
                });
            }
            return Ok(list);
        }
        [HttpPost("chat/send")]
        public async Task<IActionResult> SendChatMessage([FromBody] ChatMessageDto msg)
        {
            string sql = @"
        INSERT INTO Gen_Tra_ChatMessages (SenderId, ReceiverId, MessageContent) 
        VALUES (@Sender, @Receiver, @Content)";

            await DataHelper.ExecuteNonQuery(sql,
                new Parameter("@Sender", SqlDbType.VarChar, msg.SenderId),
                new Parameter("@Receiver", SqlDbType.VarChar, msg.ReceiverId),
                new Parameter("@Content", SqlDbType.NVarChar, msg.MessageContent));

            // --- REAL-TIME SIGNALR BROADCAST ---
            // Instantly notify the receiver if they are connected, without querying the database again
            await _hubContext.Clients.Group(msg.ReceiverId).SendAsync("ReceiveMessage", msg.SenderId, msg.MessageContent);

            return Ok();
        }



        [HttpGet("complaints/paginated/{compCode}")]
        public IActionResult GetPaginatedComplaints(string compCode, [FromQuery] int pageNumber = 1, [FromQuery] int pageSize = 10)
        {
            try
            {
                // 1. Calculate boundaries for pagination
                int skip = (pageNumber - 1) * pageSize;
                int totalRecords = 0;
                List<ComplaintDto> list = new();

                // 2. QUERY 1: Fetch the Total Count using your existing DataHelper method
                string countSql = "SELECT COUNT(*) AS TotalCount FROM CBS_tra_NewComplaint WHERE Comp_code = @Comp;";

                DataTable dtCount = DataHelper.GetTable(countSql,
                    new Parameter("@Comp", SqlDbType.VarChar, compCode));

                if (dtCount != null && dtCount.Rows.Count > 0)
                {
                    totalRecords = Convert.ToInt32(dtCount.Rows[0]["TotalCount"]);
                }

                // 3. QUERY 2: Fetch the Paginated rows with OFFSET and FETCH NEXT
                string dataSql = @"
            SELECT a.Complaint_id, a.Comp_code, a.Client_code, b.Project_name, a.Project_code, 
                   a.Project_start_date, a.Project_completion_date, a.Amc_start_date, a.Amc_finish_date, 
                   a.Issue_description, a.Support_doc1, a.Support_doc2, a.Support_doc3, a.Support_doc4, 
                   a.Support_doc5, a.Issue_raised_by, a.Issue_booked_date, a.Issue_allotted_date, 
                   a.Issue_allotted_to, a.Issue_closed_date, a.Inserted_dt, b.Start_dt, b.Completed_dt, 
                   b.AMC_Start_dt, b.AMC_End_dt
            FROM CBS_tra_NewComplaint a 
            LEFT JOIN Cbs_mas_clientproject b 
                   ON a.Comp_code = b.Comp_code 
                  AND a.Client_code = b.Client_code 
                  AND a.Project_code = b.Project_code
            WHERE a.Comp_code = @Comp
            ORDER BY a.Complaint_id DESC -- Required for OFFSET. Ordered by newest complaints first
            OFFSET @Skip ROWS FETCH NEXT @Take ROWS ONLY;";

                DataTable dtData = DataHelper.GetTable(dataSql,
                    new Parameter("@Comp", SqlDbType.VarChar, compCode),
                    new Parameter("@Skip", SqlDbType.Int, skip),
                    new Parameter("@Take", SqlDbType.Int, pageSize));

                if (dtData != null)
                {
                    foreach (DataRow r in dtData.Rows)
                    {
                        list.Add(new ComplaintDto
                        {
                            Complaint_id = Convert.ToInt32(r["Complaint_id"]),
                            Comp_code = r["Comp_code"].ToString()!,
                            Client_code = r["Client_code"].ToString()!,
                            Project_code = r["Project_code"].ToString()!,
                            Project_name = r["Project_name"].ToString()!,
                            Issue_description = r["Issue_description"].ToString()!,
                            Project_start_date = r["Project_start_date"] != DBNull.Value ? Convert.ToDateTime(r["Project_start_date"]) : null,
                            Project_completion_date = r["Project_completion_date"] != DBNull.Value ? Convert.ToDateTime(r["Project_completion_date"]) : null,
                            AMC_Start_dt = r["Amc_start_date"] != DBNull.Value ? Convert.ToDateTime(r["Amc_start_date"]) : null,
                            AMC_End_dt = r["Amc_finish_date"] != DBNull.Value ? Convert.ToDateTime(r["Amc_finish_date"]) : null,
                            Support_doc1 = r["Support_doc1"].ToString()!,
                            Support_doc2 = r["Support_doc2"].ToString()!,
                            Support_doc3 = r["Support_doc3"].ToString()!,
                            Support_doc4 = r["Support_doc4"].ToString()!,
                            Support_doc5 = r["Support_doc5"].ToString()!,
                            Issue_raised_by = r["Issue_raised_by"].ToString()!,
                            Issue_booked_date = r["Issue_booked_date"] != DBNull.Value ? Convert.ToDateTime(r["Issue_booked_date"]) : null,
                            Issue_allotted_to = r["Issue_allotted_to"].ToString()!,
                            Issue_allotted_date = r["Issue_allotted_date"] != DBNull.Value ? Convert.ToDateTime(r["Issue_allotted_date"]) : null,
                            Issue_closed_date = r["Issue_closed_date"] != DBNull.Value ? Convert.ToDateTime(r["Issue_closed_date"]) : null,
                            Inserted_dt = r["Inserted_dt"] != DBNull.Value ? Convert.ToDateTime(r["Inserted_dt"]) : null,
                            Start_dt = r["Start_dt"] != DBNull.Value ? Convert.ToDateTime(r["Start_dt"]) : null,
                            Completed_dt = r["Completed_dt"] != DBNull.Value ? Convert.ToDateTime(r["Completed_dt"]) : null
                        });
                    }
                }

                // 4. Wrap everything into the structured paginated output model
                var result = new PaginatedResult<ComplaintDto>
                {
                    Data = list,
                    TotalRecords = totalRecords
                };

                return Ok(result);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error processing paginated complaints list.");
                return StatusCode(500, $"Internal server error: {ex.Message}");
            }
        }
    }
}
