        [HttpPost("send-otp")]
        public async Task<IActionResult> SendOtp([FromBody] string email)
        {
            var otp = Random.Shared.Next(100000, 999999).ToString();
            var expiry = DateTime.UtcNow.AddMinutes(5);

            using var con = new SqlConnection(DataHelper.ConnectionString);
            await con.OpenAsync();

            var cmd = new SqlCommand(
                "INSERT INTO PasswordResetOtp (Email, Otp, ExpiresAt) VALUES (@e,@o,@x)", con);

            cmd.Parameters.AddWithValue("@e", email);
            cmd.Parameters.AddWithValue("@o", otp);
            cmd.Parameters.AddWithValue("@x", expiry);

            await cmd.ExecuteNonQueryAsync();

            // TEMP email (replace later)
            //Console.WriteLine($"OTP for {email} = {otp}");
            var smtp = new SmtpClient("smtp.gmail.com", 587)
            {
                Credentials = new NetworkCredential("cvsplotp@gmail.com", "dumdaovjmnitjbpl"),
                EnableSsl = true
            };

            await smtp.SendMailAsync(
                "cvsplotp@gmail.com",
                email,
                "Your OTP",
                $"Your OTP is {otp}. It expires in 5 minutes."
            );

            return Ok();
        }
        [HttpPost("verify-otp")]
        public async Task<IActionResult> VerifyOtp([FromBody] VerifyOtpDto dto)
        {
            using var con = new SqlConnection(DataHelper.ConnectionString);
            await con.OpenAsync();

            var cmd = new SqlCommand(@"
            SELECT COUNT(*) FROM PasswordResetOtp
            WHERE Email=@e AND Otp=@o AND ExpiresAt > GETUTCDATE() AND IsUsed=0", con);

            cmd.Parameters.AddWithValue("@e", dto.Email);
            cmd.Parameters.AddWithValue("@o", dto.Otp);

            var count = (int)await cmd.ExecuteScalarAsync();

            if (count == 0)
                return Ok("Invalid or expired OTP");

            return Ok();
        }
        public static bool IsPasswordValid(string password)
        {
            bool hasLower = false;
            bool hasUpper = false;
            bool hasDigit = false;
            bool hasSpace = false;

            if (string.IsNullOrEmpty(password) || password.Length < 8)
            {
                return false;
            }

            foreach (char c in password)
            {
                if (char.IsLower(c))
                {
                    hasLower = true;
                }
                else if (char.IsUpper(c))
                {
                    hasUpper = true;
                }
                else if (char.IsDigit(c))
                {
                    hasDigit = true;
                }
                if (c == ' ' || c == '#' || c == '$')
                {
                    hasSpace = true;
                }
            }

            return hasLower && hasUpper && hasDigit && !hasSpace;
        }
        public class PasswordRuleResult
        {
            public bool MinLength { get; set; }
            public bool HasUpper { get; set; }
            public bool HasLower { get; set; }
            public bool HasDigit { get; set; }
            public bool NoInvalidChars { get; set; }
            public bool NotLast3Passwords { get; set; }
            public bool ValidEmailDomain { get; set; }
            public bool ChangedAfter30Days { get; set; }
            public bool AllPassed =>
        MinLength &&
        HasUpper &&
        HasLower &&
        HasDigit &&
        NoInvalidChars &&
        NotLast3Passwords &&
        ChangedAfter30Days;
        }

        public class resetpasswordresponse
        {
            public string result { get; set; } = string.Empty;
            public bool redirect { get; set; } = false;
        }
        [HttpPost("validate-password")]
        public IActionResult ValidatePassword([FromBody] ResetPasswordDto dto)
        {
            DataTable dt = DataHelper.GetTable("select top 3 Password from " + DataHelper.LogDBName + ".dbo.Gen_mas_login where Login_id='" + dto.Email + "' order by LDate_time desc");
            bool found = false;
            foreach (DataRow dr in dt.Rows)
            {
                string oldpasswords = dr["Password"].ToString();
                string Curpwd_decrypt = "";
                foreach (char c in oldpasswords)
                {
                    Curpwd_decrypt += (char)(c - 120);
                }
                if (Curpwd_decrypt == dto.NewPassword)
                {
                    found = true;
                    break;
                }
            }
            var result = new PasswordRuleResult
            {
                MinLength = dto.NewPassword?.Length >= 8,
                HasUpper = dto.NewPassword.Any(char.IsUpper),
                HasLower = dto.NewPassword.Any(char.IsLower),
                HasDigit = dto.NewPassword.Any(char.IsDigit),
                NoInvalidChars = !dto.NewPassword.Any(c => c == ' ' || c == '\'' || c == '"' || c == '#' || c == '$'),
                ValidEmailDomain = dto.Email.EndsWith("@delphitvs.com", StringComparison.OrdinalIgnoreCase),

                // These two usually need DB
                ChangedAfter30Days = true,        // check last change date
                NotLast3Passwords = !found          // check password history
            };

            return Ok(result);
        }

        [HttpPost("reset")]
        public async Task<IActionResult> ResetPassword([FromBody] ResetPasswordDto dto)
        {
            resetpasswordresponse rpr = new resetpasswordresponse();

            using var con = new SqlConnection(DataHelper.ConnectionString);
            await con.OpenAsync();
            string plantcode = dto.Plant;
            // validate OTP again
            var validateCmd = new SqlCommand(@"
            SELECT COUNT(*) FROM PasswordResetOtp
            WHERE Email=@e AND Otp=@o AND ExpiresAt > GETUTCDATE() AND IsUsed=0", con);

            validateCmd.Parameters.AddWithValue("@e", dto.Email);
            validateCmd.Parameters.AddWithValue("@o", dto.Otp);

            if ((int)await validateCmd.ExecuteScalarAsync() == 0)
            {
                rpr.result = "OTP invalid";
                return Ok(rpr);
            }

            // TODO: update password here
            // Example:
            // UPDATE Users SET PasswordHash = HASHBYTES(...) WHERE Email=@e

            var markUsed = new SqlCommand(
                "UPDATE PasswordResetOtp SET IsUsed=1 WHERE Email=@e AND Otp=@o", con);

            markUsed.Parameters.AddWithValue("@e", dto.Email);
            markUsed.Parameters.AddWithValue("@o", dto.Otp);

            await markUsed.ExecuteNonQueryAsync();
            if (!IsPasswordValid(dto.NewPassword))
            {
                rpr.result = "<u>Password rules:</u><br/>1.Password should be changed once in 30 days<br/>2.New password should not be selected from the last 3 passwords<br/>3.For Delphi-TVS employees, user id should end with @delphitvs.com<br/>4.Spaces, single quotes or double quotes or # or $ should not be used in password.<br/>5.Minimum password length should be 8<br/>6.Password should be combination of alphabets and numeric. Special characters can be used.<br/>7.There should be at least 1 capital letter, 1 small letter and 1 number.";
                return Ok(rpr);
            }
            DataTable dt = DataHelper.GetTable("select top 3 Password from " + DataHelper.LogDBName + ".dbo.Gen_mas_login where Login_id='" + dto.Email + "' order by LDate_time desc");
            bool found = false;
            foreach (DataRow dr in dt.Rows)
            {
                string oldpasswords = dr["Password"].ToString();
                string Curpwd_decrypt = "";
                foreach (char c in oldpasswords)
                {
                    Curpwd_decrypt += (char)(c - 120);
                }
                if (Curpwd_decrypt == dto.NewPassword)
                {
                    found = true;
                    break;
                }
            }
            if (found)
            {
                rpr.result = "This password was used few days back. Please type a different password.";
                return Ok(rpr);

            }

            //begintrans
            int rowsAffected = 0;
            string temp = dto.NewPassword, Newpwd = "", Curpwd = "";
            Curpwd = Convert.ToString(await DataHelper.ExecuteScalar("select Password from Gen_mas_login where Login_Id='" + dto.Email + "'  and Comp_Code='" + plantcode + "' "));

            string query = "update Gen_mas_Login set Password = @NewPassword, Last_Login=getdate() Where Login_Id= @Login_Id and Comp_Code=@Comp_Code";


            foreach (char c in temp)
            {
                Newpwd += (char)(c + 120);
            }


            //temp = ChangePassword2.CurrentPassword;
            //foreach (char c in temp)
            //{
            //    Curpwd += (char)(c + 120);
            //}

            rowsAffected = await DataHelper.ExecuteNonQuery(query,

                    new Parameter("@Login_Id", SqlDbType.VarChar, dto.Email),
                    //new Parameter("@CurrPassword", SqlDbType.VarChar, Curpwd),
                    new Parameter("@NewPassword", SqlDbType.VarChar, Newpwd),
                    new Parameter("@Comp_Code", SqlDbType.VarChar, plantcode.ToString())


                );

            if (rowsAffected > 0)
            {
                string emp_no = "";
                string Valid_from = "";
                string Valid_to = "";
                string Last_login = "";
                string Expand_all_while_loading = "";
                DataTable dt_login = DataHelper.GetTable("select * from Gen_mas_login where Comp_code='" + plantcode + "' and Login_id='" + dto.Email + "' ");
                if (dt_login.Rows.Count > 0)
                {
                    emp_no = dt_login.Rows[0]["Emp_no"].ToString();
                    Valid_from = Convert.ToDateTime(dt_login.Rows[0]["Valid_from"]).ToString("yyyy-MM-dd");
                    Valid_to = Convert.ToDateTime(dt_login.Rows[0]["Valid_to"]).ToString("yyyy-MM-dd");
                    Last_login = Convert.ToDateTime(dt_login.Rows[0]["Last_login"].ToString()).ToString("yyyy-MM-dd HH:mm:ss.fff");
                    Expand_all_while_loading = dt_login.Rows[0]["Expand_all_while_loading"].ToString();
                }
                await DataHelper.ExecuteNonQuery("insert " + DataHelper.LogDBName + ".dbo.Gen_mas_login(LLogin_id,LHost_name,LDate_time,LManipulation,Comp_code,Login_id,Password,Emp_no,Valid_from,Valid_to,Last_login,Expand_all_while_loading)"
                + "values('" + dto.Email + "','" + DataHelper.HostName +
                "','" + DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss.fff") + "','U','" + plantcode + "','" + dto.Email + "','" + Curpwd + "','" + emp_no + "','" + Valid_from + "','" + Valid_to + "','" + Last_login + "','" + Expand_all_while_loading + "')");
                //lblMessageOTP.ForeColor = Color.Green;
                //lblMessageOTP.Text = "Password has been changed successfully. \nPlease Close the window and Enter the new password ";
                //Response.Redirect("Dashboard2.aspx");
                rpr.result = "Password has been changed successfully. \nPlease Close the window and Enter the new password ";
                rpr.redirect = true;
                return Ok(rpr);
            }
            //committrans
            else
            {
                //lblMessageOTP.ForeColor = Color.Red;
                //lblMessageOTP.Text = "Password does not match with our database records.";
                rpr.result = "Password does not match with our database records.";
                return Ok(rpr);
            }
            return Ok();
        }
