        [HttpGet("clients/{CompCode}")]
        public IActionResult GetClients(string? CompCode)
        {
            DataTable dt = DataHelper.GetTable(
                    "SELECT distinct b.Client_code Client_code, a.Comp_full_name Client_name FROM /*Cbs_mas_client*/Gen_mas_company a left join Cbs_mas_clientproject b on a.Comp_code=b.Comp_code where  CASE WHEN @CompCode='cvspl' THEN a.cOMP_cODE ELSE '' END != CASE WHEN @CompCode='cvspl' THEN @CompCode ELSE '' END OR CASE WHEN @CompCode='cvspl' THEN @CompCode ELSE a.cOMP_cODE END = CASE WHEN @CompCode='cvspl' THEN '' ELSE @CompCode END"
                , new Parameter("@CompCode",SqlDbType.NVarChar,CompCode));
            List<Client> result = new List<Client>();
            Client c = new Client();
            foreach(DataRow r in dt.Rows)
            {
                c = new Client();
                c.Client_code = r["Client_code"].ToString();
                c.Client_name = r["Client_name"].ToString();
                result.Add(c);
            }
            return Ok(
                result
            );
        }
