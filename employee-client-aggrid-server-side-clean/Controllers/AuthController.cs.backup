        [HttpGet("google-callback-2/{mail}")]
        public async Task<IActionResult> GoogleCallback2(string mail)
        {
            string loginid = "";
            if (!string.IsNullOrEmpty(mail))
            {
                // Use parameterized queries to prevent SQL injection
                string sql = "SELECT Login_id FROM Gen_mas_Login WHERE Emp_no IN (SELECT Emp_no FROM Pay_mas_employee WHERE Corporate_Email = @email)";
                loginid = Convert.ToString(await DataHelper.ExecuteScalar(sql, new Parameter("@email", SqlDbType.VarChar, mail)));


                var result_ = _formFactor.ValidateLogin("E", loginid, loginid + (char)4);

                return Ok(result_);
            }
            return Ok(null);
        }
            [HttpGet("google-callback")]
        public async Task<IActionResult> GoogleCallback()
        {
            var authenticateResult = await HttpContext.AuthenticateAsync(CookieAuthenticationDefaults.AuthenticationScheme);

            if (!authenticateResult.Succeeded)
                return Redirect("/login?error=google_auth_failed");

            var email = authenticateResult.Principal.FindFirst(ClaimTypes.Email)?.Value;

            if (!string.IsNullOrEmpty(email))
            {
                // Use parameterized queries to prevent SQL injection
                string sql = "SELECT Login_id FROM Gen_mas_Login WHERE Emp_no IN (SELECT Emp_no FROM Pay_mas_employee WHERE Corporate_Email = @email)";
                var loginid = Convert.ToString(await DataHelper.ExecuteScalar(sql, new Parameter("@email", SqlDbType.VarChar, email)));

                if (!string.IsNullOrEmpty(loginid))
                {
                    // You can add the loginid to the claims so it persists in the cookie
                    var claims = new List<Claim>
            {
                new Claim("loginid", loginid),
                new Claim(ClaimTypes.Email, email)
            };

                    var claimsIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(claimsIdentity));

                    return Redirect("http://localhost:7008/IHDMaster_1");
                }
            }

            return Redirect("/login?error=user_not_found");
        }
        [HttpGet("search")]
        public async Task<IActionResult> GetWeightedSearchResults([FromQuery] string? term="")
        {
            //if (string.IsNullOrWhiteSpace(term)) return Ok(new List<SearchResultDto>());

            // Using DataHelper
            var results = DataHelperSp.GetTable(
                "sp_GetWeightedSearchResults", new Parameter("@SearchTerm", SqlDbType.NVarChar, term));
            //new { SearchTerm = term },
            //CommandType.StoredProcedure);
            List<SearchResultDto> srd = new List<SearchResultDto>();
            foreach (DataRow result in results.Rows)
            {
                SearchResultDto sr=new SearchResultDto();
                sr.TargetUrl    = result["TargetUrl"].ToString();
                sr.ItemName = result["ItemName"].ToString();
                sr.ItemKey = result["ItemKey"].ToString();
                //sr.ItemType = result["ItemType"].ToString();
                sr.WeightCategory= result["WeightCategory"].ToString();
                sr.WeightScore = DataHelper.GetInt(result["WeightScore"].ToString());
                sr.PosX= DataHelper.GetInt(result["PosX"].ToString());
                sr.PosY= DataHelper.GetInt(result["PosY"].ToString());
                srd.Add(sr);
            }
            return Ok(srd);
        }

        [HttpPost("search/weight")]
        public async Task<IActionResult> IncrementClickWeight([FromBody] UpdateWeightRequest request)
        {
            string sql = @"
            IF EXISTS (SELECT 1 FROM Gen_tra_SearchWeights WHERE Item_Type = @ItemType AND Item_Key = @ItemKey)
            BEGIN
                UPDATE Gen_tra_SearchWeights SET Click_Count = Click_Count + 1, Last_Clicked = GETDATE()
                WHERE Item_Type = @ItemType AND Item_Key = @ItemKey
            END
            ELSE
            BEGIN
                INSERT INTO Gen_tra_SearchWeights (Item_Type, Item_Key, Item_Name, Target_Url, Click_Count, Last_Clicked)
                VALUES (@ItemType, @ItemKey, @ItemName, @TargetUrl, 1, GETDATE())
            END";

            await DataHelper.ExecuteNonQuery(sql,
                new Parameter("@ItemType",SqlDbType.NVarChar,request.ItemType),
                new Parameter("@ItemKey", SqlDbType.NVarChar, request.ItemKey),
                new Parameter("@ItemName", SqlDbType.NVarChar, request.ItemName),
                new Parameter("@TargetUrl", SqlDbType.NVarChar, request.TargetUrl)
                );
            return Ok();
        }

