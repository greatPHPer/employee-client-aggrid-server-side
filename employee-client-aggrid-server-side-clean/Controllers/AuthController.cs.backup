            [HttpGet("menu/{moduleCode}")]
        public IActionResult GetMenu(string moduleCode)
        {
            string sql = @"
        WITH MenuCTE AS
        (
            SELECT
                Form_rep_sl,
                Form_rep_parsl,
                Form_rep_lvl,
                Form_rep_name,
                Form_rep_mdesc,
                Menu_icon,
                0 AS LevelNo
            FROM GEN_mas_Formrep
            WHERE RTRIM(Module_code) = @Module
              AND Form_rep_parsl = 0

            UNION ALL

            SELECT
                c.Form_rep_sl,
                c.Form_rep_parsl,
                c.Form_rep_lvl,
                c.Form_rep_name,
                c.Form_rep_mdesc,
                c.Menu_icon,
                p.LevelNo + 1
            FROM GEN_mas_Formrep c
            INNER JOIN MenuCTE p
                ON c.Form_rep_parsl = p.Form_rep_sl
            WHERE RTRIM(c.Module_code) = @Module
        )
        SELECT *
        FROM MenuCTE
        ORDER BY LevelNo, Form_rep_sl";

            Parameter[] param =
            {
            new Parameter("@Module",SqlDbType.VarChar, moduleCode)
        };

            DataTable dt = DataHelper.GetTable(sql, param);

            // ---- Convert DataTable  Flat List
            var list = new List<MenuDto>();

            foreach (DataRow row in dt.Rows)
            {
                list.Add(new MenuDto
                {
                    Sl = Convert.ToInt32(row["Form_rep_sl"]),
                    ParentSl = Convert.ToInt32(row["Form_rep_parsl"]),
                    Level = row["Form_rep_lvl"].ToString()!,
                    Name = row["Form_rep_mdesc"].ToString()!,
                    Url = row["Form_rep_lvl"].ToString() == "F"
                            ? row["Form_rep_name"].ToString()!
                            : "",
                    Icon = row["Menu_icon"]?.ToString()
                });
            }

            // ---- Build Tree
            var lookup = list.ToDictionary(x => x.Sl);
            var roots = new List<MenuDto>();

            foreach (var item in list)
            {
                if (item.ParentSl == 0)
                {
                    roots.Add(item);
                }
                else if (lookup.TryGetValue(item.ParentSl, out var parent))
                {
                    parent.Children.Add(item);
                }
            }

            return Ok(roots);
        }
