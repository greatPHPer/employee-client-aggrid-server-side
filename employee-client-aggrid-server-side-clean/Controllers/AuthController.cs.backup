        [HttpPost("chat/markread")]
        public async Task<IActionResult> MarkMessagesAsRead([FromBody] MarkReadDto request)
        {
            // Update DB row status values
            string sql = @"UPDATE Gen_Tra_ChatMessages 
                   SET IsRead = 1 
                   WHERE SenderId = @Sender AND ReceiverId = @Receiver AND IsRead = 0";

            await DataHelper.ExecuteNonQuery(sql,
                new Parameter("@Sender", SqlDbType.VarChar, request.SenderId),
                new Parameter("@Receiver", SqlDbType.VarChar, request.ReceiverId));

            // Real-time notification: Alert the original sender that their messages have been read
            await _hubContext.Clients.Group(request.SenderId).SendAsync("MessagesMarkedRead", request.ReceiverId);

            return Ok();
        }
