                    new Parameter("@Client", SqlDbType.VarChar, clientCode)
                    ,
                    //
                    //Comp_Code = @CompCode and
                    //, new Parameter("@CompCode", SqlDbType.NVarChar, CompCode),
                    new Parameter("@Project", SqlDbType.VarChar, projectCode)
                );
            List<ComplaintDto> result = new List<ComplaintDto>();
            ComplaintDto c = new ComplaintDto();
            foreach (DataRow r in dt.Rows)
            {
                c = new ComplaintDto();
                c.Project_start_date = (r["Start_dt"]!=DBNull.Value?Convert.ToDateTime(r["Start_dt"]):null);
                c.Project_completion_date= (r["Completed_dt"] != DBNull.Value ? Convert.ToDateTime(r["Completed_dt"]) : null);
                c.Amc_start_date = (r["Amc_Start_dt"] != DBNull.Value ? Convert.ToDateTime(r["Amc_Start_dt"]) : null);
                c.Amc_finish_date = (r["Amc_End_dt"] != DBNull.Value ? Convert.ToDateTime(r["Amc_End_dt"]) : null);
                return Ok(
                c
            );result.Add(c);
            }
            
return NotFound();
            //if (project == null) 

            //return Ok(project);
        }
        // 1. Modify the existing SaveComplaint method:
        [HttpPost("saveComp/{currentUserId}")]
        public async Task<IActionResult> SaveComplaint(string currentUserId, [FromBody] ComplaintDto m)
        {
            // Use ExecuteScalar and SELECT SCOPE_IDENTITY() to get the new Complaint_id
            object resultId = await DataHelper.ExecuteScalar(@"
        INSERT INTO CBS_tra_NewComplaint
        (Comp_code, Client_code, Project_code,
         Project_start_date, Project_completion_date,
         Amc_start_date, Amc_finish_date,
         Issue_description,
         Support_doc1, Support_doc2, Support_doc3, Support_doc4, Support_doc5,
         Issue_raised_by, Issue_booked_date,
         Issue_allotted_date, Issue_allotted_to, Issue_closed_date, Inserted_dt)
        VALUES
        (@Comp,@Client,@Project,
         @Ps,@Pc,@As,@Af,
         @Issue,
         @D1,@D2,@D3,@D4,@D5,
         @RaisedBy,@Booked,@Allotted,@AllottedTo,@Closed, GETDATE());
         
         SELECT SCOPE_IDENTITY();",
                new[]
                {
            new Parameter("@Comp",SqlDbType.VarChar, m.Comp_code),
            new Parameter("@Client",SqlDbType.VarChar, m.Client_code),
            new Parameter("@Project",SqlDbType.VarChar, m.Project_code),
            new Parameter("@Ps",SqlDbType.VarChar, (m.Project_start_date!=null?m.Project_start_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value) ),
            new Parameter("@Pc",SqlDbType.VarChar, (m.Project_completion_date!=null?m.Project_completion_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
            new Parameter("@As",SqlDbType.VarChar, (m.Amc_start_date !=null?m.Amc_start_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
            new Parameter("@Af",SqlDbType.VarChar, (m.Amc_finish_date !=null?m.Amc_finish_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
            new Parameter("@Issue",SqlDbType.VarChar, m.Issue_description),
            new Parameter("@D1",SqlDbType.VarChar, m.Support_doc1),
            new Parameter("@D2",SqlDbType.VarChar, m.Support_doc2),
            new Parameter("@D3",SqlDbType.VarChar, m.Support_doc3),
            new Parameter("@D4",SqlDbType.VarChar, m.Support_doc4),
            new Parameter("@D5",SqlDbType.VarChar, m.Support_doc5),
            new Parameter("@RaisedBy",SqlDbType.VarChar, m.Issue_raised_by),
            new Parameter("@Booked",SqlDbType.VarChar, (m.Issue_booked_date!=null?m.Issue_booked_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
            new Parameter("@Allotted",SqlDbType.VarChar, (m.Issue_allotted_date!=null?m.Issue_allotted_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
            new Parameter("@AllottedTo",SqlDbType.VarChar, m.Issue_allotted_to),
            new Parameter("@Closed",SqlDbType.VarChar, (m.Issue_closed_date!=null?m.Issue_closed_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value))
                });

            int newComplaintId = Convert.ToInt32(resultId);

            // The name displayed in the alert (what you typed in the box)
            string displaySender = m.Issue_raised_by ?? "System";

            string alertMsg = $"New complaint raised by {displaySender} for project {m.Project_code}.";

            // 2. EXCLUDE the actual logged-in user (currentUserId) from receiving the alert
            DataTable usersDt = DataHelper.GetTable(
                "SELECT Login_id FROM Gen_mas_login WHERE Login_id != @Me and Comp_code=@CompCode",
                new Parameter("@Me", SqlDbType.VarChar, currentUserId),
                new Parameter("@CompCode", SqlDbType.VarChar, m.Comp_code) // Uses the real login ID now!
            );

            foreach (DataRow row in usersDt.Rows)
            {
                string receiver = row["Login_id"].ToString();

                // Insert into DB (using currentUserId as the actual system sender)
               await DataHelper.ExecuteNonQuery(@"
            INSERT INTO CBS_tra_ComplaintAlerts (Complaint_id, SenderId, ReceiverId, Message) 
            VALUES (@C, @S, @R, @M)",
                    new Parameter("@C", SqlDbType.Int, newComplaintId),
                    new Parameter("@S", SqlDbType.VarChar, currentUserId), // Logged-in user
                    new Parameter("@R", SqlDbType.VarChar, receiver),
                    new Parameter("@M", SqlDbType.VarChar, alertMsg)
                );

                int newAlertId = Convert.ToInt32(await DataHelper.ExecuteScalar("SELECT MAX(AlertId) FROM CBS_tra_ComplaintAlerts WHERE ReceiverId=@R", new Parameter("@R", SqlDbType.VarChar, receiver)));

                var alertDto = new AlertDto
                {
                    AlertId = newAlertId,
                    Complaint_id = newComplaintId,
                    SenderId = currentUserId,
                    ReceiverId = receiver,
                    Message = alertMsg,
                    IsRead = false,
                    Inserted_dt = DateTime.Now
                };

                // Fire real-time notification
                await _hubContext.Clients.Group(receiver).SendAsync("ReceiveAlert", alertDto);
                await _hubContext.Clients.All.SendAsync("RefreshComplaintGrid", currentUserId,m.Comp_code);
            }

            return Ok();
        }

        // 2. Add new endpoints at the bottom of AuthController.cs
        [HttpGet("alerts/{userId}")]
        public IActionResult GetUnreadAlerts(string userId)
        {
            string sql = @"
        SELECT AlertId, Complaint_id, SenderId, ReceiverId, Message, IsRead, Inserted_dt 
        FROM CBS_tra_ComplaintAlerts 
        WHERE ReceiverId = @Me AND IsRead = 0 
        ORDER BY Inserted_dt DESC";

            DataTable dt = DataHelper.GetTable(sql, new Parameter("@Me", SqlDbType.VarChar, userId));
            var list = new List<AlertDto>();

            foreach (DataRow row in dt.Rows)
            {
                list.Add(new AlertDto
                {
                    AlertId = Convert.ToInt32(row["AlertId"]),
                    Complaint_id = Convert.ToInt32(row["Complaint_id"]),
                    SenderId = row["SenderId"].ToString()!,
                    ReceiverId = row["ReceiverId"].ToString()!,
                    Message = row["Message"].ToString()!,
                    IsRead = Convert.ToBoolean(row["IsRead"]),
                    Inserted_dt = Convert.ToDateTime(row["Inserted_dt"])
                });
            }
            return Ok(list);
        }

        [HttpPost("alerts/markread/{alertId}")]
        public async Task<IActionResult> MarkAlertAsRead(int alertId)
        {
            await DataHelper.ExecuteNonQuery(
                "UPDATE CBS_tra_ComplaintAlerts SET IsRead = 1 WHERE AlertId = @Id",
                new Parameter("@Id", SqlDbType.Int, alertId));
            return Ok();
        }
        [HttpPost("saveComp_update")]
        public async Task<IActionResult> SaveComplaint_updateonly([FromBody] ComplaintDto m)
        {
            await DataHelper.ExecuteNonQuery(@"
            update CBS_tra_NewComplaint
            set Comp_code=@Comp ,Client_code=@Client, Project_code=@Project,
             Project_start_date=@Ps, Project_completion_date=@Pc,
             Amc_start_date=@As, Amc_finish_date=@Af,
             Issue_description=@Issue,
             Support_doc1=@D1, Support_doc2=@D2, Support_doc3=@D3, Support_doc4=@D4, Support_doc5=@D5,
             Issue_raised_by=@RaisedBy, Issue_booked_date=@Booked,
             Issue_allotted_date=@Allotted, Issue_allotted_to=@AllottedTo, Issue_closed_date=@Closed
            
where Complaint_id=@C_id",
                new[]
                {
                new Parameter("@C_id",SqlDbType.VarChar, m.Complaint_id),
                new Parameter("@Comp",SqlDbType.VarChar, m.Comp_code),
                new Parameter("@Client",SqlDbType.VarChar, m.Client_code),
                new Parameter("@Project",SqlDbType.VarChar, m.Project_code),
                new Parameter("@Ps",SqlDbType.VarChar, (m.Project_start_date!=null?m.Project_start_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value) ),
                new Parameter("@Pc",SqlDbType.VarChar, (m.Project_completion_date!=null?m.Project_completion_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
                new Parameter("@As",SqlDbType.VarChar, (m.Amc_start_date !=null?m.Amc_start_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
                new Parameter("@Af",SqlDbType.VarChar, (m.Amc_finish_date !=null?m.Amc_finish_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
                new Parameter("@Issue",SqlDbType.VarChar, m.Issue_description),
                new Parameter("@D1",SqlDbType.VarChar, m.Support_doc1),
                new Parameter("@D2",SqlDbType.VarChar, m.Support_doc2),
                new Parameter("@D3",SqlDbType.VarChar, m.Support_doc3),
                new Parameter("@D4",SqlDbType.VarChar, m.Support_doc4),
                new Parameter("@D5",SqlDbType.VarChar, m.Support_doc5),
                new Parameter("@RaisedBy",SqlDbType.VarChar, m.Issue_raised_by),
                new Parameter("@Booked",SqlDbType.VarChar, (m.Issue_booked_date!=null?m.Issue_booked_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
                new Parameter("@Allotted",SqlDbType.VarChar, (m.Issue_allotted_date!=null?m.Issue_allotted_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value)),
                new Parameter("@AllottedTo",SqlDbType.VarChar, m.Issue_allotted_to),
                new Parameter("@Closed",SqlDbType.VarChar, (m.Issue_closed_date!=null?m.Issue_closed_date?.ToString("yyyy-MM-dd"):(object)DBNull.Value))
                });

            return Ok();
        }
        [HttpGet("complaints/{compCode}")]
        public IActionResult GetComplaints(string compCode)
        {
            DataTable dt = DataHelper.GetTable(
                @"SELECT a.Complaint_id,a.Comp_code,a.Client_code,b.Project_name,a.Project_code,a.Project_start_date,a.Project_completion_date,a.Amc_start_date,a.Amc_finish_date,a.Issue_description,a.Support_doc1,a.Support_doc2,a.Support_doc3,a.Support_doc4,a.Support_doc5,a.Issue_raised_by,a.Issue_booked_date,a.Issue_allotted_date,a.Issue_allotted_to,a.Issue_closed_date,a.Inserted_dt,b.Start_dt,b.Completed_dt,b.AMC_Start_dt,b.AMC_End_dt
          FROM CBS_tra_NewComplaint a left join Cbs_mas_clientproject b on a.Comp_code=b.Comp_code and a.Client_code=b.Client_code and a.Project_code=b.Project_code
          WHERE a.Comp_code=@Comp",
                new Parameter("@Comp", SqlDbType.VarChar, compCode));

            List<ComplaintDto> list = new();

            foreach (DataRow r in dt.Rows)
            {
                list.Add(new ComplaintDto
                {
                    Complaint_id = Convert.ToInt32(r["Complaint_id"]),
                    Comp_code = r["Comp_code"].ToString()!,
                    Client_code = r["Client_code"].ToString()!,
                    Project_code = r["Project_code"].ToString()!,
                    Project_name = r["Project_name"].ToString()!,
                    Issue_description = r["Issue_description"].ToString()!,
                    Project_start_date = r["Project_start_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Project_start_date"])
                        : null,
                    Project_completion_date = r["Project_completion_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Project_completion_date"])
                        : null,
                    AMC_Start_dt = r["Amc_start_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Amc_start_date"])
                        : null,
                    AMC_End_dt = r["Amc_finish_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Amc_finish_date"])
                        : null,
                    Support_doc1 = r["Support_doc1"].ToString()!,
                    Support_doc2 = r["Support_doc2"].ToString()!,
                    Support_doc3 = r["Support_doc3"].ToString()!,
                    Support_doc4 = r["Support_doc4"].ToString()!,
                    Support_doc5 = r["Support_doc5"].ToString()!,
                    Issue_raised_by = r["Issue_raised_by"].ToString()!,
                    Issue_booked_date = r["Issue_booked_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Issue_booked_date"])
                        : null,
                    Issue_allotted_to = r["Issue_allotted_to"].ToString()!,
                    Issue_allotted_date = r["Issue_allotted_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Issue_allotted_date"])
                        : null,
                    
                    Issue_closed_date = r["Issue_closed_date"] != DBNull.Value
                        ? Convert.ToDateTime(r["Issue_closed_date"])
                        : null,
                    Inserted_dt = r["Inserted_dt"] != DBNull.Value
                        ? Convert.ToDateTime(r["Inserted_dt"])
                        : null,
                    Start_dt = r["Start_dt"] != DBNull.Value
                        ? Convert.ToDateTime(r["Start_dt"])
                        : null,
                    Completed_dt = r["Completed_dt"] != DBNull.Value
                        ? Convert.ToDateTime(r["Completed_dt"])
                        : null
                        //,
                    //AMC_Start_dt = r["AMC_Start_dt"] != DBNull.Value
                    //    ? Convert.ToDateTime(r["AMC_Start_dt"])
                    //    : null,
                    //AMC_End_dt = r["AMC_End_dt"] != DBNull.Value
                    //    ? Convert.ToDateTime(r["AMC_End_dt"])
                    //    : null,
                });
            }

            return Ok(list);
        }
        [HttpDelete("deleteComplaint/{id}")]
        public async Task<IActionResult> DeleteComplaint(int id)
        {
            int rows = await DataHelper.ExecuteNonQuery(@"
        DELETE FROM CBS_tra_NewComplaint  
        WHERE Complaint_id = @Id",
                new Parameter("@Id", SqlDbType.Int, id)
            );

            if (rows > 0)
                return Ok(new { message = "Complaint deleted successfully" });

            return NotFound(new { message = "Complaint not found" });
        }
        [HttpPost("upload-file")]
        public async Task<IActionResult> UploadFile(IFormFile file)
        {
            if (file == null || file.Length == 0)
                return BadRequest("No file selected");

            string folderPath = @"D:\";   // As requested

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            string fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.FileName);
            string fullPath = Path.Combine(folderPath, fileName);

            using (var stream = new FileStream(fullPath, FileMode.Create))
            {
                await file.CopyToAsync(stream);
            }
            var res = new { sourceFileName= file.FileName, DestinationPath= fullPath };
            return Ok(res);  // Return full path to save in DB
        }
        [HttpGet("download-file")]
        public IActionResult DownloadFile(string path)
        {
            if (string.IsNullOrEmpty(path) || !System.IO.File.Exists(path))
                return NotFound("File not found");

            var bytes = System.IO.File.ReadAllBytes(path);

            var contentType = "application/octet-stream";
            var fileName = Path.GetFileName(path);

            return File(bytes, contentType, fileName);
        }
