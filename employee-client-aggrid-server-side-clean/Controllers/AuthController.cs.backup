        [HttpGet("chat/users/{currentUserId}")]
        public IActionResult GetChatUsers(string currentUserId)
        {
            try
            {
                // Notice the new subquery counting IsRead = 0 where you are the receiver
                string sql = @"
            SELECT Login_id, 
                   CASE WHEN DATEDIFF(MINUTE, ISNULL(Last_login, '1900-01-01'), GETDATE()) < 15 THEN 1 ELSE 0 END as IsOnline,
                   (SELECT COUNT(*) FROM Gen_Tra_ChatMessages M WHERE M.SenderId = Login_id AND M.ReceiverId = @Me AND M.IsRead = 0) as UnreadCount
            FROM Gen_mas_login 
            WHERE Login_id != @Me";

                DataTable dt = DataHelper.GetTable(sql, new Parameter("@Me", SqlDbType.VarChar, currentUserId));

                var list = new List<ChatUserDto>();
                foreach (DataRow row in dt.Rows)
                {
                    list.Add(new ChatUserDto
                    {
                        LoginId = row["Login_id"]?.ToString() ?? "",
                        IsOnline = row["IsOnline"] != DBNull.Value && Convert.ToInt32(row["IsOnline"]) == 1,
                        UnreadCount = row["UnreadCount"] != DBNull.Value ? Convert.ToInt32(row["UnreadCount"]) : 0
                    });
                }
                return Ok(list);
            }
            catch (Exception ex)
            {
                return StatusCode(500, ex.Message);
            }
        }
