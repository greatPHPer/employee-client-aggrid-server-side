            await apiResponse.MarkMessagesAsRead(new MarkReadDto { SenderId = senderId, ReceiverId = receiverId }).ConfigureAwait(false);
        }
        public async Task<List<AlertDto>> GetUnreadAlertsAsync(string currentUserId)
