            }
            return new List<AlertDto>();
        }

        public async Task MarkAlertAsReadAsync(int alertId)
        {
            var apiResponse = RestService.For<IApiRefit>(ApiUrl);
            await apiResponse.MarkAlertAsRead(alertId).ConfigureAwait(false);
