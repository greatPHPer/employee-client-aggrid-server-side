    bool LOADEDAG = false;
    async Task LoadGrid()
    {
        _baseComplaints = (await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();
        // SafeClients = _baseComplaints ?? Enumerable.Empty<ComplaintDto>();
        SafeClients = _baseComplaints == null ? new List<ComplaintDto>() : _baseComplaints; ;//(await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();

        AgGrid.Blazor.ColumnDefinition a = new AgGrid.Blazor.ColumnDefinition();
        a.Field = "complaint_id"; a.IsSortable = true;a.Filter = true;
        AgGrid.Blazor.ColumnDefinition b = new AgGrid.Blazor.ColumnDefinition();
        b.Field = "client_code"; b.IsSortable = true; b.Filter = true;
        AgGrid.Blazor.ColumnDefinition c = new AgGrid.Blazor.ColumnDefinition();
        c.Field = "project_code"; c.IsSortable = true; c.Filter = true;
        AgGrid.Blazor.ColumnDefinition d = new AgGrid.Blazor.ColumnDefinition();
        d.Field = "issue_description"; d.IsSortable = true; d.Filter = true;
        List<AgGrid.Blazor.ColumnDefinition> columnDefinitions = new List<AgGrid.Blazor.ColumnDefinition>();
        columnDefinitions.Add(a);
        columnDefinitions.Add(b);
        columnDefinitions.Add(c);
        columnDefinitions.Add(d);
        gridoptions.RowData = SafeClients;//_baseComplaints==null?new List<ComplaintDto>().ToArray():_baseComplaints.ToArray();
        gridoptions.ColumnDefinitions = columnDefinitions;
        gridoptions.AnimateRows = true;
        gridoptions.EnableRangeSelection = true;
        AgGrid.Blazor.RowSelection rowSelection = AgGrid.Blazor.RowSelection.Single;
        gridoptions.RowSelection = rowSelection;
        // gridevents.SelectionChanged = OnSelectionChanged;


        // gridevents.SelectionChanged = OnRowSelected;
        // gridevents.SelectionChanged = OnGridSelectionChanged;
        // gridoptions.OnRowSelected = EventCallback.Factory.Create<AgGrid.Blazor.RowSelectedEvent>(this, OnRowSelected);
        LOADEDAG = true;

        ApplySorting();
        StateHasChanged();
        // var dotNetRef = DotNetObjectReference.Create(this);
        // await JS.InvokeVoidAsync("agGridInterop.registerSelectionChanged", dotNetRef);
        _dotNetRef = DotNetObjectReference.Create(this);
        // Ensure the JS file is loaded on the page; then call:
        await JS.InvokeVoidAsync("agGridInterop.createOrReuseGrid", myGrid, columnDefinitions, SafeClients, _dotNetRef);
        // await JS.InvokeVoidAsync("agGridInterop.registerSelectionChanged", _dotNetRef,gridoptions);
    }
