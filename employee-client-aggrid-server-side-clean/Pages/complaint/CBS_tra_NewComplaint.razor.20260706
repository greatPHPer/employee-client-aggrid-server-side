    bool seconddiv_permission = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // that = this;
            seconddiv_permission = false;
            // initial attach of row ids
            Clients = await AuthApiService.GetClientsAsync(AppSessionService2.Get<string>("CompCode")); ///////////await Task.Delay(1000);
            await LoadGrid();
            // await JS.InvokeVoidAsync("flip.attachRowIds", ".row-id[data-id]");
            //////////////////////////////await Task.Delay(1000);
            // await JS.InvokeVoidAsync("myFunctions.onLoad");
            //await Task.Delay(4000);

            await JS.InvokeVoidAsync("flyDummyToReal");


            seconddiv_permission = true;
            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above

            if(AppSessionService2.Get<string>("CompCode")=="CVSPL") 
            {
                cn_disabled=true;
                SelectedClientList = new List<Client> { Clients[0] };
            }
        }
        else
        {

            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above

        }
        if (pendingFlip)
        {
            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above
            pendingFlip = false;
            // small delay sometimes helps ensure DOM is stable
            await Task.Delay(10);
            await AfterSort();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
