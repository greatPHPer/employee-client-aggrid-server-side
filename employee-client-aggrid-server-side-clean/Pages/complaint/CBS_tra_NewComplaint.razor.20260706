<div style="margin-top:10px;">
    <button @onclick="PrevPage">Prev</button>
    <button @onclick="NextPage">Next</button>
    <button @onclick="ZoomIn">Zoom +</button>
    <button @onclick="ZoomOut">Zoom -</button>
</div>
<canvas id="myChart" width="400" height="200"></canvas>
<SfChart Title="Inflation - Consumer Price" Width="60%">
    <ChartPrimaryXAxis IntervalType="IntervalType.Years" LabelFormat="yyyy" ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime">
    </ChartPrimaryXAxis>
    <ChartSeriesCollection>
        <ChartSeries DataSource="@ConsumerReports" XName="XValue" YName="YValue" Type="ChartSeriesType.Line">
        </ChartSeries>
    </ChartSeriesCollection>
</SfChart> *@
@if (LOADEDAG == false)
{
    <p>Loading...</p>
}
else
{
    @* <AgGrid.Blazor.Grid Options="gridoptions" @ref="myGrid" Class="ag-theme-alpine" HeightStyle="500px" Events="gridevents" WidthStyle="100%"></AgGrid.Blazor.Grid> *@
    @* <AgGrid RowData="clients" Class="ag-theme-alpine" Style="height:500px;" /> *@
    <div @ref="myGrid" class="ag-theme-alpine" style="height:500px;" id="myGridId"></div>
}

<button @onclick="LoadChart">Load Chart</button>
<Toast Message="@ToastMessage" Type="success" Visible="@ShowToast" />
