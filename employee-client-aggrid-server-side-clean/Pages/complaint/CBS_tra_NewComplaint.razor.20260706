<h3>Complaint Registration</h3>
<div class=" nofade2_ fade-in1234" style="z-index:11;opacity:0;position:relative;">
    <div class=" fade-in2 nofade2_">
        <FluentGrid Spacing="1" AdaptiveRendering="true" Style="">

            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">Client</label>
                    :<FluentAutocomplete class="field"
                                         TOption="dynamic"
                                         Items="@Clients"
                                         OptionText="@(c => c.Client_name)"
                                         MaximumSelectedOptions="1"
                                         Placeholder="Search Client..."
                                         @bind-SelectedOptions="@SelectedClientList" />
                </div>
            </FluentGridItem>

            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">Project</label>
                    :<FluentAutocomplete class="field"
                                         TOption="dynamic"
                                         Items="@Projects"
                                         OptionText="@(p => p.Project_name)"
                                         MaximumSelectedOptions="1"
                                         Placeholder="Search Project..."
                                         @bind-SelectedOptions="@SelectedProjectList" />
                </div>
            </FluentGridItem>

            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">Project Start Date</label>
                    :<FluentTextField class="field"
                                      Value="@(model.Project_start_date?.ToString("dd-MM-yyyy"))"
                                      ReadOnly="true"
                                      Appearance="FluentInputAppearance.Filled" />

                    <label class="textright">Project Compl. Dt</label>
                    :<FluentTextField class="field"
                                      Value="@(model.Project_completion_date?.ToString("dd-MM-yyyy"))"
                                      ReadOnly="true"
                                      Appearance="FluentInputAppearance.Filled" />
                </div>
            </FluentGridItem>



            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">AMC Start Date</label>
                    :<FluentTextField class="field"
                                      Value="@(model.Amc_start_date?.ToString("dd-MM-yyyy"))"
                                      ReadOnly="true"
                                      Appearance="FluentInputAppearance.Filled" />
                    <label class="textright">AMC Finish Date</label>
                    :<FluentTextField class="field"
                                      Value="@(model.Amc_finish_date?.ToString("dd-MM-yyyy"))"
                                      ReadOnly="true"
                                      Appearance="FluentInputAppearance.Filled" />
                </div>
            </FluentGridItem>



            <FluentGridItem xs="12">
                <div class="form-row" style="align-items: baseline;">
                    <label class="textright">Issue Description</label>
                    :<FluentTextArea class="field"
                                     Rows="4"
                                     @bind-Value="model.Issue_description" />
                </div>
            </FluentGridItem>

            <FluentGridItem xs="12">
                <div class="form-row" style="align-items: baseline;">
                    <label class="textright">Support Documents</label>

                    :<div class="field" style="display:flex; gap:10px; flex-wrap:wrap;">

                        <FluentInputFile Id="doc1" Mode="InputFileMode.Stream" MaximumFileCount="1"
                                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                                         OnCompleted="@(e => HandleFileUpload(e, 1))">
                            <ChildContent>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; width:100%;">
                                    <label for="doc1" style="width:unset;">
                                        <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(model.Support_doc1))
                                    {
                                        <FluentButton Appearance="Appearance.Outline" OnClick="DownloadFile1">
                                            Download
                                        </FluentButton>
                                    }
                                </div>
                            </ChildContent>
                        </FluentInputFile>

                        <FluentInputFile Id="doc2" Mode="InputFileMode.Stream" MaximumFileCount="1"
                                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                                         OnCompleted="@(e => HandleFileUpload(e, 2))">
                            <ChildContent>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; width:100%;">
                                    <label for="doc2" style="width:unset;">
                                        <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(model.Support_doc2))
                                    {
                                        <FluentButton Appearance="Appearance.Outline" OnClick="DownloadFile2">
                                            Download
                                        </FluentButton>
                                    }
                                </div>
                            </ChildContent>
                        </FluentInputFile>

                        <FluentInputFile Id="doc3" Mode="InputFileMode.Stream" MaximumFileCount="1"
                                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                                         OnCompleted="@(e => HandleFileUpload(e, 3))">
                            <ChildContent>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; width:100%;">
                                    <label for="doc3" style="width:unset;">
                                        <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(model.Support_doc3))
                                    {
                                        <FluentButton Appearance="Appearance.Outline" OnClick="DownloadFile3">
                                            Download
                                        </FluentButton>
                                    }
                                </div>
                            </ChildContent>
                        </FluentInputFile>

                        <FluentInputFile Id="doc4" Mode="InputFileMode.Stream" MaximumFileCount="1"
                                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                                         OnCompleted="@(e => HandleFileUpload(e, 4))">
                            <ChildContent>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; width:100%;">
                                    <label for="doc4" style="width:unset;">
                                        <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(model.Support_doc4))
                                    {
                                        <FluentButton Appearance="Appearance.Outline" OnClick="DownloadFile4">
                                            Download
                                        </FluentButton>
                                    }
                                </div>
                            </ChildContent>
                        </FluentInputFile>

                        <FluentInputFile Id="doc5" Mode="InputFileMode.Stream" MaximumFileCount="1"
                                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                                         OnCompleted="@(e => HandleFileUpload(e, 5))">
                            <ChildContent>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; width:100%;">
                                    <label for="doc5" style="width:unset;">
                                        <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(model.Support_doc5))
                                    {
                                        <FluentButton Appearance="Appearance.Outline" OnClick="DownloadFile5">
                                            Download
                                        </FluentButton>
                                    }
                                </div>
                            </ChildContent>
                        </FluentInputFile>

                    </div>
                </div>
            </FluentGridItem>

            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">Issue Raised By</label>
                    :<FluentTextField class="field"
                                      @bind-Value="model.Issue_raised_by" />
                    <label class="textright">Issue Booked Dt</label>
                    :<FluentDatePicker class="field"
                                       @bind-Value="model.Issue_booked_date" />
                </div>
            </FluentGridItem>



            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                </div>
            </FluentGridItem>



            <FluentGridItem xs="12" sm="6">
                <div class="form-row">
                    <label class="textright">Issue Allotted Date</label>
                    :<FluentDatePicker class="field"
                                       @bind-Value="model.Issue_allotted_date" />
                    <label class="textright">Issue Allotted To</label>
                    :<FluentTextField class="field"
                                      @bind-Value="model.Issue_allotted_to" />

                </div>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="3">
                <div class="form-row">
                    <label class="textright">Issue Closed Date</label>
                    :<FluentDatePicker class="field"
                                       @bind-Value="model.Issue_closed_date" />
                </div>
            </FluentGridItem>
            @if (delsty)
            {
                <FluentGridItem xs="12" sm="3" style="text-align:right">
                    <FluentButton Appearance="Appearance.Outline" Color="Red" BackgroundColor="LightRed"
                                  @onclick="cancel">
                        Cancel to add new
                    </FluentButton>
                    @if (delsty)
                    {
                        <FluentButton Appearance="Appearance.Accent" Color="White" BackgroundColor="Red"
                                      @onclick="delete">
                            Delete
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Accent"
                                  @onclick="Save">
                        Save Complaint
                    </FluentButton>
                </FluentGridItem>
            }
            else
            {
                <FluentGridItem xs="12" sm="2" style="text-align:right">
                    <FluentButton Appearance="Appearance.Outline" Color="Red" BackgroundColor="LightRed"
                                  @onclick="cancel">
                        Cancel to add new
                    </FluentButton>
                    @if (delsty)
                    {
                        <FluentButton Appearance="Appearance.Accent" Color="White" BackgroundColor="Red"
                                      @onclick="delete">
                            Delete
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Accent"
                                  @onclick="Save">
                        Save Complaint
                    </FluentButton>
                </FluentGridItem>
            }


        </FluentGrid>
    </div>
</div>
