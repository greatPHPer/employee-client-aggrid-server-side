    async Task LoadChart()
    {
        var labels = new[] { "Jan", "Feb", "Mar", "Apr" };
        var data = new[] { 10, 25, 15, 30 };

        await JS.InvokeVoidAsync("chartHelper.renderChart", labels, data);
    }
