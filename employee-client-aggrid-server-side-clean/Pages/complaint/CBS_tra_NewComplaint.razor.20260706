    async void EditComplaint(ComplaintDto row)
    {
        editmode = "edit";
        model = new ComplaintDto
        {
            Complaint_id = row.Complaint_id,
            Comp_code = row.Comp_code,
            Support_doc1 = row.Support_doc1,
            Support_doc2 = row.Support_doc2,
            Support_doc3 = row.Support_doc3,
            Support_doc4 = row.Support_doc4,
            Support_doc5 = row.Support_doc5,
            Issue_raised_by = row.Issue_raised_by,
            Issue_booked_date = row.Issue_booked_date,
            Issue_allotted_to = row.Issue_allotted_to,
            Issue_closed_date = row.Issue_closed_date,
            Inserted_dt = row.Inserted_dt,
            Issue_allotted_date = row.Issue_allotted_date,
            // Issue_allotted_to = row.Issue_allotted_to,
            // Issue_booked_date = row.Issue_booked_date,
            // Issue_closed_date = row.Issue_closed_date,
            // Issue_raised_by = row.Issue_raised_by,
            Client_code = row.Client_code,
            Project_code = row.Project_code,
            Issue_description = row.Issue_description,
            AMC_Start_dt = row.AMC_Start_dt,
            Start_dt = row.Start_dt,
            Completed_dt = row.Completed_dt,
            AMC_End_dt = row.AMC_End_dt,
            Project_start_date = row.Project_start_date,
            Project_completion_date = row.Project_completion_date,
            Project_name = row.Project_name



        };
        tempproject = row.Project_code;
        tempprojectname = row.Project_name;
        var client = Clients.FirstOrDefault(c => c.Client_code == row.Client_code);
        if (client != null)
            SelectedClientList = new List<Client> { client };


    }

