    async Task LoadProjects()
    {
        if (string.IsNullOrEmpty(model.Client_code)) return;
        Projects = await AuthApiService.GetProjectsAsync(AppSessionService2.Get<string>("CompCode"), _selectedClients.FirstOrDefault()?.Client_code);
        SelectedProjectList = null;
        model.Project_code = null;
        if (!string.IsNullOrWhiteSpace(tempproject))
        {
            var project = Projects.FirstOrDefault(p => p.Project_code == tempproject);
            if (project != null)
                SelectedProjectList = new List<Project> { project };
            else
            {
                Project tempp = new Project();//{ Project_code = tempproject, Project_name = tempprojectname };
                tempp.Project_code = tempproject;
                tempp.Project_name = tempprojectname;
                Projects.Add(tempp);
                SelectedProjectList = new List<Project> { tempp };
            }
            tempproject = string.Empty;
        }
        StateHasChanged();

    }

    // -- File Upload Handler --
    // This function runs when a user selects a file.
    // We update the model string with the filename.
    async Task HandleFileUpload(IEnumerable<FluentInputFileEventArgs> files, int docNumber)
    {
        var file = files.FirstOrDefault();
        if (file == null) return;

        // In a real app, you might want to upload 'file.Stream' to a server here.
        // For now, we bind the filename to the model string property.
        string fileName = file.Name;
        // var filel =  file.AllFiles.FirstOrDefault();
        var content = new MultipartFormDataContent();
        var streamContent = new StreamContent(file.Stream);
        streamContent.Headers.ContentType =
            new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        content.Add(streamContent, "file", file.Name);

        var path = await AuthApiService.UploadFileAsync(content);

        // model.AttachmentPath = path.Trim('"'); // Save to model
        switch (docNumber)
        {
            case 1: model.Support_doc1 = path.Trim('"'); break;
            case 2: model.Support_doc2 = path.Trim('"'); break;
            case 3: model.Support_doc3 = path.Trim('"'); break;
            case 4: model.Support_doc4 = path.Trim('"'); break;
            case 5: model.Support_doc5 = path.Trim('"'); break;
        }

        // Optional: Log or process the stream
        // var stream = file.Stream;
    }
    string editmode = "add";
    async Task Save()
    {
        // Note: This only sends the JSON model (with filenames).
        // To send actual files, you would need to use MultipartFormDataContent instead of PostAsJsonAsync.
        if (editmode == "add")
        {
            await AuthApiService.saveComplaint(model);
            cancel();
            ToastMessage = "Saved successfully!";
            ShowToast = true;

            StateHasChanged();

            await Task.Delay(3000);
            ShowToast = false;
        }
        else if (editmode == "edit")
        {
            await AuthApiService.saveComplaint_updateonly(model);
            editmode = "add";
            cancel();
            ToastMessage = "Updated successfully!";
            ShowToast = true;

            StateHasChanged();

            await Task.Delay(3000);
            ShowToast = false;
        }
        // await LoadGrid();
        // await JS.InvokeVoidAsync("flip.attachRowIds", ".row-id[data-id]");
        // await JS.InvokeVoidAsync("myFunctions2.onLoad2");
        _baseComplaints = (await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();
        // SafeClients = _baseComplaints ?? Enumerable.Empty<ComplaintDto>();
        SafeClients = _baseComplaints == null ? new List<ComplaintDto>() : _baseComplaints; ;//(await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();

        gridoptions.RowData = SafeClients;
        await JS.InvokeVoidAsync("agGridInterop.setRowData", SafeClients);
    }
    async Task LoadProjectDates()
    {
        if (string.IsNullOrEmpty(model.Project_code)) return;

        var details = await AuthApiService.GetProjectDetailsAsync(AppSessionService2.Get<string>("CompCode"), model.Client_code, model.Project_code);

        model.Project_start_date = details?.Project_start_date;
        model.Project_completion_date = details?.Project_completion_date;
        model.Amc_start_date = details?.Amc_start_date;
        model.Amc_finish_date = details?.Amc_finish_date;

        StateHasChanged();
    }

