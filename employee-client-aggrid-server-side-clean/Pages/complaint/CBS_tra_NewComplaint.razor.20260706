    async Task LoadPdf(string base64)
    {
        await JS.InvokeVoidAsync("blazorPdfViewer.loadPdf", pdfCanvas, base64);
    }

    async Task NextPage()
    {
        currentPage++;
        await JS.InvokeVoidAsync("blazorPdfViewer.renderPage", pdfCanvas, currentPage);
    }

    async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await JS.InvokeVoidAsync("blazorPdfViewer.renderPage", pdfCanvas, currentPage);
        }
    }

    async Task ZoomIn()
    {
        zoom += 0.2;
        await JS.InvokeVoidAsync("blazorPdfViewer.setZoom", pdfCanvas, zoom);
    }

    async Task ZoomOut()
    {
        zoom -= 0.2;
        await JS.InvokeVoidAsync("blazorPdfViewer.setZoom", pdfCanvas, zoom);
    }
