<script type="module" src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.min.mjs"></script>
<script type="module" src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.worker.min.mjs"></script>
<script type="module" src="_content/Employee_Client.Shared/jsshared/site.js"></script>
<script>
        window.blazorPdfViewer = (function () {

        let pdfDoc = null;
        let currentPage = 1;
        let scale = 1.5;

        function render(canvas, pageNumber) {
            if (!pdfDoc) return;

            pdfDoc.getPage(pageNumber).then(function (page) {

                const viewport = page.getViewport({ scale: scale });
                const context = canvas.getContext('2d');

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                page.render({
                    canvasContext: context,
                    viewport: viewport
                });
            });
        }

        return {

            loadPdf: function (canvas, base64Data) {

                if (!base64Data) {
                    console.error("Base64 empty!");
                    return;
                }

                const raw = atob(base64Data);
                const uint8Array = new Uint8Array(raw.length);

                for (let i = 0; i < raw.length; i++) {
                    uint8Array[i] = raw.charCodeAt(i);
                }

                pdfjsLib.getDocument({ data: uint8Array }).promise
                    .then(function (pdf) {

                        pdfDoc = pdf;
                        currentPage = 1;

                        render(canvas, currentPage);
                    })
                    .catch(err => console.error("PDF load error:", err));
            },

            renderPage: function (canvas, pageNumber) {

                if (!pdfDoc) return;

                if (pageNumber < 1 || pageNumber > pdfDoc.numPages) return;

                currentPage = pageNumber;
                render(canvas, currentPage);
            },

            setZoom: function (canvas, newScale) {

                scale = newScale;
                render(canvas, currentPage);
            }
        };

    })();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    window.chartHelper = {
        renderChart: function (labels, data) {

            const ctx = document.getElementById('myChart');

            new Chart(ctx, {
                type: 'bar', // try 'line', 'pie'
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Sales',
                        data: data,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true
                }
            });
        }
    };</script>
<style>
    /* Ensure inputs fill their grid cells */
    fluent-text-field, fluent-number-field, fluent-combobox, fluent-select, fluent-autocomplete, fluent-date-picker, fluent-text-area, fluent-input-file {
        width: 100%;
        font-size: 14px;
    }

    /* Force labels to stay on one line */
    fluent-grid-item label {
        white-space: nowrap !important;
    }

    /* Optional: Tweaks for file input spacing */
    .fluent-input-file-container {
        margin-top: 4px;
    }

    .form-row {
        display: flex;
        align-items: center;
        gap: 2px;
    }

        .form-row label {
            width: 135px;
            /* font-weight: 500; */
            font-size:14px;
        }

        .form-row .field {
            flex: 1;
        }

    .fluent-inputfile-container{
        width:170px;
    }
    .textright{
        text-align:end;
    }

    .fluent-data-grid-row {
        font-size: 14px !important;
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .fluent-data-grid  td{
        padding: 0px 16px;
    }
</style>
