    object pdfContainer;
    private TaskCompletionSource<bool> _signal = new();
    private bool _myVariable = false;
    bool seconddiv_permission = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            seconddiv_permission = false;
            // initial attach of row ids
            Clients = await AuthApiService.GetClientsAsync(AppSessionService2.Get<string>("CompCode")); await Task.Delay(1000);
            await LoadGrid();
            await JS.InvokeVoidAsync("flip.attachRowIds", ".row-id[data-id]");
            await Task.Delay(1000);
            await JS.InvokeVoidAsync("myFunctions.onLoad");
            //await Task.Delay(4000);

            await JS.InvokeVoidAsync("flyDummyToReal");


            seconddiv_permission = true;
            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above
        }
        else{

            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above

        }
        if (pendingFlip)
        {
            _myVariable = true;
            _signal.TrySetResult(true); // This releases the awaiter above
            pendingFlip = false;
            // small delay sometimes helps ensure DOM is stable
            await Task.Delay(10);
            await AfterSort();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
    // string currentSortColumn = null;
    // bool sortDescending = false;
    // bool pendingFlip = false;

    // Store the original fetched data so we can re-sort it without losing data
    List<ComplaintDto> _baseComplaints = new();
    bool pendingFlip = false;

    public class SortInfo
    {
        public string Column { get; set; }
        public bool Descending { get; set; }
    }

    // Holds our active sorting criteria
    List<SortInfo> activeSorts = new List<SortInfo>();
    async Task SortBy(string column, MouseEventArgs e)
    {
        await BeforeSort();

        // Check if the user is holding Shift or Ctrl for multi-sort
        bool isMultiSort = e.CtrlKey || e.ShiftKey;
        var existingSort = activeSorts.FirstOrDefault(s => s.Column == column);

        if (!isMultiSort)
        {
            // Single sort mode: clear others
            bool wasDesc = existingSort?.Descending ?? false;
            activeSorts.Clear();

            if (existingSort != null)
                activeSorts.Add(new SortInfo { Column = column, Descending = !wasDesc }); // Toggle
            else
                activeSorts.Add(new SortInfo { Column = column, Descending = false });    // Ascending
        }
        else
        {
            // Multi sort mode
            if (existingSort != null)
            {
                if (!existingSort.Descending)
                    existingSort.Descending = true; // Toggle Asc -> Desc
                else
                    activeSorts.Remove(existingSort); // Desc -> Remove sort completely
            }
            else
            {
                activeSorts.Add(new SortInfo { Column = column, Descending = false });
            }
        }

        ApplySorting();

        pendingFlip = true;
        StateHasChanged();
    }

    void ApplySorting()
    {
        if (!activeSorts.Any())
        {
            Complaints = _baseComplaints.AsQueryable();
            return;
        }

        IOrderedEnumerable<ComplaintDto> orderedList = null;

        for (int i = 0; i < activeSorts.Count; i++)
        {
            var sort = activeSorts[i];
            if (i == 0)
            {
                orderedList = sort.Column switch
                {
                    "Complaint_id" => sort.Descending ? _baseComplaints.OrderByDescending(c => c.Complaint_id) : _baseComplaints.OrderBy(c => c.Complaint_id),
                    "Project_code" => sort.Descending ? _baseComplaints.OrderByDescending(c => c.Project_code) : _baseComplaints.OrderBy(c => c.Project_code),
                    "Issue_description" => sort.Descending ? _baseComplaints.OrderByDescending(c => c.Issue_description) : _baseComplaints.OrderBy(c => c.Issue_description),
                    _ => _baseComplaints.OrderBy(c => 1)
                };
            }
            else
            {
                orderedList = sort.Column switch
                {
                    "Complaint_id" => sort.Descending ? orderedList.ThenByDescending(c => c.Complaint_id) : orderedList.ThenBy(c => c.Complaint_id),
                    "Project_code" => sort.Descending ? orderedList.ThenByDescending(c => c.Project_code) : orderedList.ThenBy(c => c.Project_code),
                    "Issue_description" => sort.Descending ? orderedList.ThenByDescending(c => c.Issue_description) : orderedList.ThenBy(c => c.Issue_description),
                    _ => orderedList.ThenBy(c => 1)
                };
            }
        }

        Complaints = orderedList.AsQueryable();
    }

