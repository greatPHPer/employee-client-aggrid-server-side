</style>
<h3>Complaint Registration</h3>
<div class=" nofade2_ fade-in1234" style="z-index:11;opacity:0;position:relative;">
    <div class=" fade-in2 nofade2_">
        <FluentGrid Spacing="1" AdaptiveRendering="true" Style="">

    <FluentGridItem xs="12" sm="6">
        <div class="form-row">
            <label class="textright">Client</label>
            :<FluentAutocomplete class="field"
                                TOption="dynamic"
                                Items="@Clients"
                                OptionText="@(c => c.Client_name)"
                                MaximumSelectedOptions="1"
                                Placeholder="Search Client..."
                                @bind-SelectedOptions="@SelectedClientList" />
        </div>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6">
        <div class="form-row">
            <label class="textright">Project</label>
            :<FluentAutocomplete class="field"
                                TOption="dynamic"
                                Items="@Projects"
                                OptionText="@(p => p.Project_name)"
                                MaximumSelectedOptions="1"
                                Placeholder="Search Project..."
                                @bind-SelectedOptions="@SelectedProjectList" />
        </div>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6">
        <div class="form-row">
            <label class="textright">Project Start Date</label>
            :<FluentTextField class="field"
                             Value="@(model.Project_start_date?.ToString("dd-MM-yyyy"))"
                             ReadOnly="true"
                             Appearance="FluentInputAppearance.Filled" />
        
            <label class="textright">Project Compl. Dt</label>
            :<FluentTextField class="field"
                              Value="@(model.Project_completion_date?.ToString("dd-MM-yyyy"))"
                              ReadOnly="true"
                              Appearance="FluentInputAppearance.Filled" />
        </div>
    </FluentGridItem>

    

    <FluentGridItem xs="12" sm="6">
