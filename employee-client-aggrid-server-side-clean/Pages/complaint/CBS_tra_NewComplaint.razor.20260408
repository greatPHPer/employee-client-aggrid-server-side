    bool LOADEDAG = false;
    async Task LoadGrid()
    {
        _baseComplaints = (await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();
        // SafeClients = _baseComplaints ?? Enumerable.Empty<ComplaintDto>();
        SafeClients = _baseComplaints == null ? new List<ComplaintDto>() : _baseComplaints; ;//(await AuthApiService.GetGridData_newcomplaint(AppSessionService2.Get<string>("CompCode")) ?? new()).ToList();

        AgGrid.Blazor.ColumnDefinition a = new AgGrid.Blazor.ColumnDefinition();
        a.Field = "Complaint_id";a.IsSortable = true;//a.filte = true;
        AgGrid.Blazor.ColumnDefinition b = new AgGrid.Blazor.ColumnDefinition();
        b.Field = "Client_code";
        AgGrid.Blazor.ColumnDefinition c = new AgGrid.Blazor.ColumnDefinition();
        c.Field = "Project_code";
        AgGrid.Blazor.ColumnDefinition d = new AgGrid.Blazor.ColumnDefinition();
        d.Field = "Issue_description";
        List<AgGrid.Blazor.ColumnDefinition> columnDefinitions = new List<AgGrid.Blazor.ColumnDefinition>();
        columnDefinitions.Add(a);
        columnDefinitions.Add(b);
        columnDefinitions.Add(c);
        columnDefinitions.Add(d);
        gridoptions.RowData = _baseComplaints;//_baseComplaints==null?new List<ComplaintDto>().ToArray():_baseComplaints.ToArray();
        gridoptions.ColumnDefinitions = columnDefinitions;
        LOADEDAG = true;
        ApplySorting();
        StateHasChanged();
    }
    public List<ComplaintDto> SafeClients { get; set; } = new();//= _baseComplaints ?? Enumerable.Empty<ComplaintDto>();
