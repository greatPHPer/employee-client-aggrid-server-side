<h4 style="margin-top:30px">Complaints List</h4>



<FluentDataGrid TGridItem="ComplaintDto" Items="@Complaints"
                TItem="ComplaintDto"
                GridTemplateColumns="80px 200px 200px 1fr 120px"
                RowSize="DataGridRowSize.Small">

    @* <PropertyColumn Property="c => c.Complaint_id" Title="ID" Sortable="true" /> *@
        <TemplateColumn Title="ID">
        <ChildContent Context="context">
        <span class="row-id" data-id="@context.Complaint_id" style="display:none"></span>
        @context.Complaint_id
    </ChildContent>
</TemplateColumn>

    <PropertyColumn Property="c => c.Client_code" Title="Client" Sortable="true" />

    @* <PropertyColumn Property="c => c.Project_code" Title="Project" Sortable="true" /> *@
        <TemplateColumn Title="Project">
        <HeaderCellTitleTemplate>

            <FluentButton class="col-sort-button" @onclick='(MouseEventArgs e) => SortBy("Project_code", e)' Appearance="Appearance.Stealth">
                <div class="col-title-text" style="font-weight: 600;">Project </div>
                @* @if (currentSortColumn == "Project_code")
                {
                    @if (sortDescending)
                    {
