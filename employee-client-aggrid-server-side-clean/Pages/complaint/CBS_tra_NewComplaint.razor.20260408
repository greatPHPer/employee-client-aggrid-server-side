    // FLIP helpers
    Dictionary<string, double> oldPositions;
    // bool pendingFlip = false;
    string flipRowSelector = ".row-id"; // used by measure/animate

    // Call before you change the collection (sort)
    async Task BeforeSort()
    {
        // Ensure row ids are attached
        await JS.InvokeVoidAsync("flip.attachRowIds", ".row-id[data-id]");
        oldPositions = await JS.InvokeAsync<Dictionary<string, double>>("flip.measureRows", flipRowSelector);
    }

    // Call after render to animate
    async Task AfterSort()
    {
        await JS.InvokeVoidAsync("flip.animateRows", flipRowSelector, oldPositions);
        oldPositions = null;
    }

