@page "/complaint/CBS_tra_NewComplaint"
@using Employee_Client.Shared.Layout
@using Employee_Client.Shared.Model.complaint
@using Employee_Client.Shared.Services
@* @inject AppSessionService AppSession; *@
@using Microsoft.FluentUI.AspNetCore.Components
@layout MainLayout
@inject NavigationManager NavigationManager
@inject AuthApiService AuthApiService

<style>
    /* Ensure inputs fill their grid cells */
    fluent-text-field, fluent-number-field, fluent-combobox, fluent-select, fluent-autocomplete, fluent-date-picker, fluent-text-area, fluent-input-file {
        width: 100%;
    }

    /* Force labels to stay on one line */
    fluent-grid-item label {
        white-space: nowrap !important;
    }

    /* Optional: Tweaks for file input spacing */
    .fluent-input-file-container {
        margin-top: 4px;
    }
</style>

<h3>Complaint Registration</h3>

<FluentGrid Spacing="3" AdaptiveRendering="true">

    <FluentGridItem xs="12" sm="3">
        <FluentAutocomplete TOption="dynamic"
                            Label="Client"
                            Items="@Clients"
                            OptionText="@(c => c.Client_name)"
                            MaximumSelectedOptions="1"
                            Placeholder="Search Client..."
                            @bind-SelectedOptions="@SelectedClientList" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentAutocomplete TOption="dynamic"
                            Label="Project"
                            Items="@Projects"
                            OptionText="@(p => p.Project_name)"
                            MaximumSelectedOptions="1"
                            Placeholder="Search Project..."
                            @bind-SelectedOptions="@SelectedProjectList" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="Project Start Date"
                         Value="@(model.Project_start_date?.ToString("dd-MM-yyyy"))"
                         ReadOnly="true"
                         Appearance="FluentInputAppearance.Filled" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="Project Completion Date"
                         Value="@(model.Project_completion_date?.ToString("dd-MM-yyyy"))"
                         ReadOnly="true"
                         Appearance="FluentInputAppearance.Filled" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="AMC Start Date"
                         Value="@(model.Amc_start_date?.ToString("dd-MM-yyyy"))"
                         ReadOnly="true"
                         Appearance="FluentInputAppearance.Filled" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="AMC Finish Date"
                         Value="@(model.Amc_finish_date?.ToString("dd-MM-yyyy"))"
                         ReadOnly="true"
                         Appearance="FluentInputAppearance.Filled" />
    </FluentGridItem>

    <FluentGridItem xs="12">
        <FluentTextArea Label="Issue Description"
                        Rows="4"
                        @bind-Value="model.Issue_description" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="2">
        <FluentInputFile Id="doc1"
                         Mode="InputFileMode.Stream"
                         MaximumFileCount="1"
                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                         OnCompleted="@(e => HandleFileUpload(e, 1))">
            <ChildContent>
                <label for="doc1">
                    <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                </label>
                
                    
                @if (!string.IsNullOrEmpty(model.Support_doc1))
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="DownloadFile1">
                        Download Attachment
                    </FluentButton>
                }
                @* <div>
                    Drag files here you wish to upload,
                    or <label for="doc2">browse</label>
                    for them<span style="color: red;">*</span>.
                    <br />
                    <em>Maximum of 4 files allowed.</em>
                </div> *@


            </ChildContent>
        </FluentInputFile>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="2">
        <FluentInputFile Id="doc2"
                         Mode="InputFileMode.Stream"
                         MaximumFileCount="1"
                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                         OnCompleted="@(e => HandleFileUpload(e, 2))">
            @* <label slot="label">Support Document 2</label> *@
            <ChildContent>
                <label for="doc2">
                    <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                </label>
                @* <label slot="label">Support Document 2</label> *@
                
                @if (!string.IsNullOrEmpty(model.Support_doc2))
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="DownloadFile2">
                        Download Attachment
                    </FluentButton>
                }
                @* <div>
                    Drag files here you wish to upload,
                    or <label for="doc2">browse</label>
                    for them<span style="color: red;">*</span>.
                    <br />
                    <em>Maximum of 4 files allowed.</em>
                </div> *@

                
            </ChildContent>
        </FluentInputFile>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="2">
        <FluentInputFile Id="doc3"
                         Mode="InputFileMode.Stream"
                         MaximumFileCount="1"
                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                         OnCompleted="@(e => HandleFileUpload(e, 3))">
            <ChildContent>
                <label for="doc3">
                    <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                </label>
                
                @if (!string.IsNullOrEmpty(model.Support_doc3))
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="DownloadFile3">
                        Download Attachment
                    </FluentButton>
                }
                @* <div>
                    Drag files here you wish to upload,
                    or <label for="doc2">browse</label>
                    for them<span style="color: red;">*</span>.
                    <br />
                    <em>Maximum of 4 files allowed.</em>
                </div> *@


            </ChildContent>
        </FluentInputFile>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="2">
        <FluentInputFile Id="doc4"
                         Mode="InputFileMode.Stream"
                         MaximumFileCount="1"
                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                         OnCompleted="@(e => HandleFileUpload(e, 4))">
            <ChildContent>
                <label for="doc4">
                    <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                </label>
                
                @if (!string.IsNullOrEmpty(model.Support_doc4))
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="DownloadFile4">
                        Download Attachment
                    </FluentButton>
                }
                @* <div>
                    Drag files here you wish to upload,
                    or <label for="doc2">browse</label>
                    for them<span style="color: red;">*</span>.
                    <br />
                    <em>Maximum of 4 files allowed.</em>
                </div> *@


            </ChildContent>
        </FluentInputFile>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="2">
        <FluentInputFile Id="doc5"
                         Mode="InputFileMode.Stream"
                         MaximumFileCount="1"
                         Accept=".pdf,.jpg,.png,.docx,.xlsx"
                         OnCompleted="@(e => HandleFileUpload(e, 5))">
            <ChildContent>
                <label for="doc5">
                    <FluentIcon Value="@(new @Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                </label>
                
                @if (!string.IsNullOrEmpty(model.Support_doc5))
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="DownloadFile5">
                        Download Attachment
                    </FluentButton>
                }
                @* <div>
                    Drag files here you wish to upload,
                    or <label for="doc2">browse</label>
                    for them<span style="color: red;">*</span>.
                    <br />
                    <em>Maximum of 4 files allowed.</em>
                </div> *@


            </ChildContent>
        </FluentInputFile>
    </FluentGridItem>

    <FluentGridItem xs="0" sm="4"></FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="Issue Raised By"
                         @bind-Value="model.Issue_raised_by" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentDatePicker Label="Issue Booked Date"
                          @bind-Value="model.Issue_booked_date" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentDatePicker Label="Issue Allotted Date"
                          @bind-Value="model.Issue_allotted_date" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentTextField Label="Issue Allotted To"
                         @bind-Value="model.Issue_allotted_to" />
    </FluentGridItem>

    <FluentGridItem xs="12" sm="3">
        <FluentDatePicker Label="Issue Closed Date"
                          @bind-Value="model.Issue_closed_date" />
    </FluentGridItem>

    <FluentGridItem xs="12" Justify="JustifyContent.FlexEnd">
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="Save">
            Save Complaint
        </FluentButton>
    </FluentGridItem>

</FluentGrid>

@code {
    string? DownloadUrl1;
    void DownloadFile1()
    {
        DownloadUrl1 = $"https://localhost:7235/Auth/download-file?path={Uri.EscapeDataString(model.Support_doc1)}";
        NavigationManager.NavigateTo(DownloadUrl1, true);
    }
    string? DownloadUrl2;
    void DownloadFile2()
    {
        DownloadUrl2 = $"https://localhost:7235/Auth/download-file?path={Uri.EscapeDataString(model.Support_doc2)}";
        NavigationManager.NavigateTo(DownloadUrl2, true);
    }
    string? DownloadUrl3;
    void DownloadFile3()
    {
        DownloadUrl3 = $"https://localhost:7235/Auth/download-file?path={Uri.EscapeDataString(model.Support_doc3)}";
        NavigationManager.NavigateTo(DownloadUrl3, true);
    }
    string? DownloadUrl4;
    void DownloadFile4()
    {
        DownloadUrl4 = $"https://localhost:7235/Auth/download-file?path={Uri.EscapeDataString(model.Support_doc4)}";
        NavigationManager.NavigateTo(DownloadUrl4, true);
    }
    string? DownloadUrl5;
    void DownloadFile5()
    {
        DownloadUrl5 = $"https://localhost:7235/Auth/download-file?path={Uri.EscapeDataString(model.Support_doc5)}";
        NavigationManager.NavigateTo(DownloadUrl5, true);
    }
    ComplaintDto model = new() { Comp_code = "CVSPL" };

    List<Client> Clients = new();
    List<Project> Projects = new();

    // -- Autocomplete Logic --
    IEnumerable<dynamic> _selectedClients;
    IEnumerable<dynamic> SelectedClientList
    {
        get => _selectedClients;
        set
        {
            _selectedClients = value;
            if (_selectedClients != null && _selectedClients.Any())
            {
                var selected = _selectedClients.First();
                model.Client_code = selected.Client_code;
                //InvokeAsync(async () => { await LoadProjects(); });
                LoadProjects();
                //  new Task(async () =>
                // {
                //     await LoadProjects();
                // }).Start();
            }
        }
    }

    IEnumerable<dynamic> _selectedProjects;
    IEnumerable<dynamic> SelectedProjectList
    {
        get => _selectedProjects;
        set
        {
            _selectedProjects = value;
            if (_selectedProjects != null && _selectedProjects.Any())
            {
                var selected = _selectedProjects.First();
                model.Project_code = selected.Project_code;
                // Populate readonly dates from selected project if data is available
                LoadProjectDates();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Clients = await AuthApiService.GetClientsAsync(AppSession.Current.Get<string>("CompCode"));
    }

    async Task LoadProjects()
    {
        if (string.IsNullOrEmpty(model.Client_code)) return;
        Projects = await AuthApiService.GetProjectsAsync(AppSession.Current.Get<string>("CompCode"),_selectedClients.FirstOrDefault()?.Client_code);
        SelectedProjectList = null;
        model.Project_code = null;
        StateHasChanged();
    }

    // -- File Upload Handler --
    // This function runs when a user selects a file.
    // We update the model string with the filename.
    async Task HandleFileUpload(IEnumerable<FluentInputFileEventArgs> files, int docNumber)
    {
        var file = files.FirstOrDefault();
        if (file == null) return;

        // In a real app, you might want to upload 'file.Stream' to a server here.
        // For now, we bind the filename to the model string property.
        string fileName = file.Name;
        // var filel =  file.AllFiles.FirstOrDefault();
        var content = new MultipartFormDataContent();
        var streamContent = new StreamContent(file.Stream);
        streamContent.Headers.ContentType =
            new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        content.Add(streamContent, "file", file.Name);

        var path = await AuthApiService.UploadFileAsync(content);

        // model.AttachmentPath = path.Trim('"'); // Save to model
        switch (docNumber)
        {
            case 1: model.Support_doc1 = path.Trim('"'); break;
            case 2: model.Support_doc2 = path.Trim('"'); break;
            case 3: model.Support_doc3 = path.Trim('"'); break;
            case 4: model.Support_doc4 = path.Trim('"'); break;
            case 5: model.Support_doc5 = path.Trim('"'); break;
        }
        
        // Optional: Log or process the stream
        // var stream = file.Stream;
    }

    async Task Save()
    {
        // Note: This only sends the JSON model (with filenames).
        // To send actual files, you would need to use MultipartFormDataContent instead of PostAsJsonAsync.
        await  AuthApiService.saveComplaint( model);
    }
    async Task LoadProjectDates()
    {
        if (string.IsNullOrEmpty(model.Project_code)) return;

        var details = await AuthApiService.GetProjectDetailsAsync(model.Comp_code,model.Client_code, model.Project_code);

        model.Project_start_date = details?.Project_start_date;
        model.Project_completion_date = details?.Project_completion_date;
        model.Amc_start_date = details?.Amc_start_date;
        model.Amc_finish_date = details?.Amc_finish_date;

        StateHasChanged();
    }
}