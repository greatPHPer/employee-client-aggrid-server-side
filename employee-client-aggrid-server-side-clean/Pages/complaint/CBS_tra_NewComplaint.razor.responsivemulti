    public async ValueTask DisposeAsync()
    {
        
        _disposed = true;

        _cts.Cancel();
        _cts.Dispose();

        _dotNetRef?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("agGridInterop.destroyGrid");
            if (_SignalRService.Connection is not null)
            {
                await _SignalRService.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore - browser already left the page
        }
        catch (ObjectDisposedException)
        {
            // Ignore
        }
    }
